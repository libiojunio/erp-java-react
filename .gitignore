# Root .gitignore for ERP Multiempresa

# IDEs and Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
.factorypath

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Backend (Maven / Java)
backend/target/
backend/*.log
backend/.flattened-pom.xml

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.eslintcache
frontend/coverage/

# Docker volumes & local data
.docker-data/
*.h2.db
