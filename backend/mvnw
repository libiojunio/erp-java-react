#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper script for POSIX systems
# ----------------------------------------------------------------------------

set -e

# Find Maven home or download wrapper if needed
PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
MAVEN_PROJECTBASEDIR=`dirname "$PRG"`
cd "$MAVEN_PROJECTBASEDIR"
MAVEN_PROJECTBASEDIR=`pwd`

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Check if wrapper jar exists, else download or run with installed maven
if [ ! -f "$WRAPPER_JAR" ]; then
  if command -v mvn > /dev/null 2>&1; then
    exec mvn "$@"
  fi
  # Try to download maven-wrapper.jar
  echo "Downloading maven-wrapper..."
  mkdir -p "$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
  JAR_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL "$JAR_URL" -o "$WRAPPER_JAR"
  elif command -v wget > /dev/null 2>&1; then
    wget -q "$JAR_URL" -O "$WRAPPER_JAR"
  fi
fi

if [ -f "$WRAPPER_JAR" ]; then
  exec java -jar "$WRAPPER_JAR" "$@"
else
  echo "Maven não encontrado e não foi possível baixar o wrapper automaticamente."
  echo "Por favor instale o Maven no WSL com: sudo apt update && sudo apt install -y maven"
  exit 1
fi
